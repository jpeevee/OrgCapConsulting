---
// src/layouts/layout.astro
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Partnering with you to uplift your capabilities." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-[#EFECE6] text-[#0C1B2A] min-h-screen flex flex-col font-sans antialiased selection:bg-[#2B8C96] selection:text-white">

    <!-- Header / Navbar -->
    <header class="bg-[#EFECE6] border-b border-[#D8D3C8] sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
        <!-- Larger Logo -->
        <a href="#" class="flex items-center gap-2">
          <img 
            src="/OrgCapConsulting_logo_rev.webp" 
            alt="OrgCap Consulting Logo" 
            class="h-12 sm:h-14 w-auto object-contain"
          />
        </a>

        <!-- Anchor Navigation Links -->
        <nav class="hidden md:flex items-center space-x-9 text-base font-semibold text-[#0C1B2A]">
          <a href="#about" class="hover:text-[#2B8C96] transition">About</a>
          <a href="#services" class="hover:text-[#2B8C96] transition">Services</a>
          <a href="#contact" class="hover:text-[#2B8C96] transition">Contact</a>
        </nav>

        <!-- Header CTA Button -->
        <a href="#contact" class="px-6 py-3 bg-[#2B8C96] hover:bg-[#216F77] text-white font-bold rounded-xl text-xs sm:text-sm uppercase tracking-wider transition shadow-sm">
          Get in touch
        </a>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer (Matched to Original Structure) -->
    <footer class="bg-[#0C1B2A] text-white py-12 border-t border-[#1C2C3D]">
      <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-slate-300">
        <div class="flex items-center gap-3">
          <img src="/OrgCapConsulting_logo_rev.webp" alt="OrgCap Logo" class="h-8 w-auto brightness-0 invert object-contain opacity-90" />
          <span class="font-bold text-white tracking-wide text-base">OrgCap Consulting</span>
        </div>
        <div class="flex gap-8 font-medium text-slate-200">
          <a href="#about" class="hover:text-[#2B8C96] transition">About</a>
          <a href="#services" class="hover:text-[#2B8C96] transition">Services</a>
          <a href="#contact" class="hover:text-[#2B8C96] transition">Contact</a>
        </div>
        <p class="text-slate-400 text-xs sm:text-sm">&copy; {new Date().getFullYear()} OrgCap Consulting. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>