---
// src/pages/index.astro
import Layout from '../layouts/layout.astro';
import { getCollection } from 'astro:content';

// Fetch the collection array and take the first item
const settingsList = await getCollection('settings');
const contact = settingsList[0]?.data;
---

<Layout title={contact ? `${contact.companyName} | Home` : "Home"}>
  {contact ? (
    <section class="text-center py-12">
      <h1 class="text-4xl font-extrabold text-white mb-4">
        Welcome to {contact.companyName}
      </h1>
      <p class="text-slate-400 text-lg mb-6">
        Call us today: <a href={`tel:${contact.phone}`} class="text-indigo-400 hover:underline">{contact.phone}</a>
      </p>
      <div class="inline-block bg-slate-800 p-4 rounded-lg border border-slate-700">
        <p class="text-sm text-slate-300">Email: {contact.email}</p>
        <p class="text-sm text-slate-300">Location: {contact.address}</p>
      </div>
    </section>
  ) : (
    <p class="text-slate-400 text-center py-12">Contact settings file not found.</p>
  )}
</Layout>
