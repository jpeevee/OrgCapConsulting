---
// src/pages/[slug].astro
import Layout from '../layouts/layout.astro';
import { getCollection, render } from 'astro:content';

// 1. Tell Astro which static URLs to build at build time
export async function getStaticPaths() {
  const pageEntries = await getCollection('pages');
  return pageEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

// 2. Fetch data for the matching page
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Blueprint`}>
  <section class="max-w-4xl mx-auto py-12 px-4">
    <div class="mb-8 border-b border-slate-800 pb-6">
      <h1 class="text-4xl font-extrabold text-white tracking-tight mb-2">
        {entry.data.title}
      </h1>
      {entry.data.subtitle && (
        <p class="text-xl text-slate-400">{entry.data.subtitle}</p>
      )}
    </div>

    <!-- Rendered Markdown Body Content -->
    <div class="prose prose-invert max-w-none text-slate-300 leading-relaxed space-y-4">
      <Content />
    </div>
  </section>
</Layout>